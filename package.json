{
  "name": "konuzastro-tracker",
  "description": "KONUZASTRO Tracker — astrophotography night session planner, 2D/3D sky dome, framing & mosaic simulator, and plate-solved object distance inspector",
  "license": "MIT AND SEE LICENSE IN LICENSE-ASSETS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Konuz/Session-Planner.git"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/compress-dist.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env.local server/index.ts",
    "up": "node scripts/up.ts",
    "up:dev": "node scripts/up.ts --dev",
    "build:data": "node scripts/build-data.ts",
    "setup:skyshot": "node scripts/setup-skyshot.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.22",
    "astronomy-engine": "2.1.19",
    "fast-xml-parser": "5.11.2",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.34.5",
    "three": "0.186.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "~6.0.3",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  }
}
